# Payment Manager
NEXT_PUBLIC_PAYMENT_MANAGER_URL="https://storageamla.blob.core.windows.net/plugin-payment/PaymentManager_1.1.2.js"

# Security Configuration
NODE_TLS_REJECT_UNAUTHORIZED=0

# Logging and Caching
LOGGING_METHOD="FILE"   # or "API"
CACHE_MEMORY="FILE" # or "REDIS"
ENABLE_CACHE=false
ENABLE_PAGE_CACHE=false
CACHE_EXPIRY=3600 #redis key expiration in seconds

# Redis Configuration
REDIS_CONNECTION_STRING=redis://localhost:6379
REDIS_SENTINELS=""
REDIS_SENTINEL_MASTER_NAME=""
REDIS_PASSWORD=""
REDIS_SENTINEL_ENABLED=false


NEW_RELIC_APP_NAME=""
NEW_RELIC_LICENSE_KEY=""

# Storage Configuration
STORAGE="FILE" # "REDIS" | "FILE" | "CDN" is used for Cache Storage 

# for 301 redirection--> if it set to false then 301 redirection will be restricted i.e IS_301_REDIRECT=false
IS_301_REDIRECT="true"

DISABLE_CONSOLE_LOG=""
IS_INGRESS_ENABLED="true"

# For accessing client debug api(NextJs route)
ZNODE_DEBUG_TOKEN="dev_6f3d8c2b1eaa47bfa8c9f4c2a0e93d51"