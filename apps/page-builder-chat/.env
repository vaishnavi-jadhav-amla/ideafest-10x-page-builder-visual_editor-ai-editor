# Dev uses ../../node_modules/next from the repo root (see project.json). Avoid npx next@VERSION on Windows — it can break webpack paths.
# ---------------------------------------------------------------------------
# Products carousel — chat: "add products" / "add product carousel"
# ---------------------------------------------------------------------------
# GET unassociated products (OData-style query built server-side):
PAGE_BUILDER_GET_CMS_WIDGET_SLIDER_BANNER_URL=https://apigateways-z10-dev10.znodecorp.com/CMSWidgetConfiguration/GetCMSWidgetSliderBanner

PAGE_BUILDER_GET_UNASSOCIATED_PRODUCT_LIST_URL=https://apigateways-z10-dev10.znodecorp.com/CMSWidgetConfiguration/GetUnAssociatedProductList
# POST associate selected SKUs:
PAGE_BUILDER_ASSOCIATE_PRODUCT_URL=https://apigateways-z10-dev10.znodecorp.com/CMSWidgetConfiguration/AssociateProduct
# Reuses PAGE_BUILDER_SLIDER_AUTHORIZATION or PAGE_BUILDER_PUBLISH_PREVIEW_AUTHORIZATION.
PAGE_BUILDER_PRODUCT_CAROUSEL_MASTER_KEY=666
PAGE_BUILDER_PRODUCT_CAROUSEL_DISPLAY_NAME=Product List
PAGE_BUILDER_PRODUCT_CAROUSEL_WIDGET_CODE=ProductList
PAGE_BUILDER_PRODUCT_LIST_PAGE_SIZE=10
PAGE_BUILDER_PRODUCT_LIST_LOCALE_ID=1
PAGE_BUILDER_ASSOCIATE_PRODUCT_CMS_WIDGETS_ID=1
PAGE_BUILDER_ASSOCIATE_PRODUCT_ENABLE_PREVIEW=false
# Reuses PAGE_BUILDER_CMS_MAPPING_ID, PAGE_BUILDER_CMS_TYPE_OF_MAPPING.
# Set to true only to skip the CMS AssociateProduct POST (page still gets the carousel block).
PAGE_BUILDER_SKIP_ASSOCIATE_PRODUCT=false
PAGE_BUILDER_DEBUG_GATEWAY_CURL=1




# POST CreateUpdateLinkWidgetConfiguration (server-side; same auth as slider/publish).
PAGE_BUILDER_CREATE_UPDATE_LINK_WIDGET_URL=https://apigateways-z10-dev10.znodecorp.com/CMSWidgetConfiguration/CreateUpdateLinkWidgetConfiguration
# Reuses PAGE_BUILDER_SLIDER_AUTHORIZATION or PAGE_BUILDER_PUBLISH_PREVIEW_AUTHORIZATION.
# Reuses PAGE_BUILDER_CMS_MAPPING_ID, PAGE_BUILDER_CMS_TYPE_OF_MAPPING, PAGE_BUILDER_CMS_WIDGETS_ID.
# Composite WidgetsKey per save: PAGE_BUILDER_LINK_PANEL_MASTER_KEY (default 2253) + UUID (matches page widgetKey).
PAGE_BUILDER_LINK_PANEL_MASTER_KEY=2253
# Form "display name" → API **Title**; **DisplayName** / **WidgetName** default **Link Panel** (widget panel label):
PAGE_BUILDER_LINK_PANEL_DISPLAY_NAME=Link Panel
PAGE_BUILDER_LINK_WIDGET_LOCALE_ID=1
PAGE_BUILDER_PORTAL_ID=0
# Optional — defaults match current gateway sample (false / false / 999 / false):
PAGE_BUILDER_LINK_WIDGET_IS_ACTIVE=true
PAGE_BUILDER_LINK_WIDGET_IS_NEW_TAB=true
PAGE_BUILDER_LINK_WIDGET_DISPLAY_ORDER=0
PAGE_BUILDER_LINK_WIDGET_ENABLE_CMS_PREVIEW=true