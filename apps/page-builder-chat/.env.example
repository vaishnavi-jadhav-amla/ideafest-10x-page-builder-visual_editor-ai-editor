# Copy to .env or .env.local in this folder: apps/page-builder-chat/
# (Next only loads env from this app directory, not the monorepo root, unless you merge env yourself.)

# Copy-paste JSON commands (no key): public/commands-reference.txt

# ---------------------------------------------------------------------------
# Local plain-text chat (default ON) — no API key
# ---------------------------------------------------------------------------
# Parses lines like: set title My Page | add heading Welcome | add text as "Hello"
# Local shortcuts run first when they match (fast). PAGE_BUILDER_CHAT_PLAIN_TEXT=false only toggles
# the "plain text on/off" label in the chat header — it does not send matching commands to Ollama.
# PAGE_BUILDER_CHAT_PLAIN_TEXT=false

# ---------------------------------------------------------------------------
# Ollama — optional local LLM (no OpenAI). Install from https://ollama.com
# ---------------------------------------------------------------------------
# PAGE_BUILDER_CHAT_OLLAMA_URL=http://127.0.0.1:11434
# PAGE_BUILDER_CHAT_OLLAMA_MODEL=llama3.2
# (Alias) OLLAMA_HOST=http://127.0.0.1:11434
#
# If you see HTTP 500 / "llama runner process has terminated": GET /api/ollama-health?probe=1 — it retries with
# CPU-only (num_gpu=0). If that works, force the same for chat:
# PAGE_BUILDER_CHAT_OLLAMA_NUM_GPU=0
#
# PAGE_BUILDER_CHAT_OLLAMA_PAGE_CHARS=3000
# PAGE_BUILDER_CHAT_OLLAMA_NUM_CTX=8192
# PAGE_BUILDER_CHAT_OLLAMA_NUM_PREDICT=1024
# Optional — Ollama JSON mode; leave unset/false if the runner crashes (we still parse JSON from the reply).
# PAGE_BUILDER_CHAT_OLLAMA_FORMAT_JSON=true

# ---------------------------------------------------------------------------
# OpenAI — optional cloud LLM
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# PAGE_BUILDER_CHAT_AI_ENABLED — false | true | (unset=auto if key exists)
#
# ---------------------------------------------------------------------------
# Claude / Anthropic — optional cloud LLM (vision-capable)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
#
# Which LLM to use (all can be configured; this chooses behavior):
# PAGE_BUILDER_CHAT_LLM_PROVIDER=auto     # default: Ollama first → Claude → OpenAI; errors fall through
# PAGE_BUILDER_CHAT_LLM_PROVIDER=ollama   # Ollama only (no fallback)
# PAGE_BUILDER_CHAT_LLM_PROVIDER=claude   # Claude only (skip Ollama and OpenAI)
# PAGE_BUILDER_CHAT_LLM_PROVIDER=openai   # OpenAI only (skip Ollama and Claude)

# Order when you press Send: plain-text → (per PAGE_BUILDER_CHAT_LLM_PROVIDER) Ollama → Claude → OpenAI → help text.

# ---------------------------------------------------------------------------
# Banner slider list (chat: "add banner slider" | "add banner" | "add bannerslider" / "add BannerSlider") — server proxies gateway
# ---------------------------------------------------------------------------
# PAGE_BUILDER_SLIDER_LIST_URL=https://apigateways-z10-dev10.znodecorp.com/Slider/SliderList
# PAGE_BUILDER_SLIDER_AUTHORIZATION=Basic <same-as-gateway>
# Or omit PAGE_BUILDER_SLIDER_AUTHORIZATION to reuse PAGE_BUILDER_PUBLISH_PREVIEW_AUTHORIZATION.
# TLS (corporate CA): same as publish — PAGE_BUILDER_SLIDER_TLS_INSECURE or PAGE_BUILDER_PUBLISH_PREVIEW_TLS_INSECURE
# Debug: GET /api/slider-list

# Before Save, server GETs GetCMSWidgetSliderBanner with filter (mapping, WidgetsKey, TypeOFMapping) to load CMSWidgetSliderBannerId / CMSWidgetsId / CMSSliderId when present.
# PAGE_BUILDER_GET_CMS_WIDGET_SLIDER_BANNER_URL=https://apigateways-z10-dev10.znodecorp.com/CMSWidgetConfiguration/GetCMSWidgetSliderBanner
# When user picks a slider, server PUTs SaveCMSWidgetSliderBanner before updating page JSON.
# PAGE_BUILDER_SAVE_CMS_WIDGET_SLIDER_BANNER_URL=https://apigateways-z10-dev10.znodecorp.com/CMSWidgetConfiguration/SaveCMSWidgetSliderBanner
# Reuses PAGE_BUILDER_SLIDER_AUTHORIZATION or PAGE_BUILDER_PUBLISH_PREVIEW_AUTHORIZATION.
# PAGE_BUILDER_CMS_MAPPING_ID=7
# PAGE_BUILDER_CMS_TYPE_OF_MAPPING=PortalMapping
# PAGE_BUILDER_CMS_WIDGET_SLIDER_BANNER_ID=0
# PAGE_BUILDER_CMS_WIDGETS_ID=0
# After first save, the app stores **cmsWidgetSliderBannerId** on the block (from JSON response when present) and sends it on **update BannerSlider-…** / SaveCMSWidgetSliderBanner.
# Local/dev without calling save: PAGE_BUILDER_SKIP_SAVE_CMS_WIDGET_SLIDER_BANNER=true
# Log copy-paste curl for each gateway call (SliderList, GetCMSWidgetSliderBanner, SaveCMSWidgetSliderBanner, SaveCmsContainerDetails) to the server terminal — includes Basic auth; use only locally.
# PAGE_BUILDER_DEBUG_GATEWAY_CURL=1

# ---------------------------------------------------------------------------
# SaveCmsContainerDetails — Home Page Promo ("add home page promo") & AdSpace ("add ad space")
# ---------------------------------------------------------------------------
# PAGE_BUILDER_SAVE_CMS_CONTAINER_DETAILS_URL=https://apigateways-z10-dev10.znodecorp.com/CMSWidgetConfiguration/SaveCmsContainerDetails
# Reuses PAGE_BUILDER_SLIDER_AUTHORIZATION or PAGE_BUILDER_PUBLISH_PREVIEW_AUTHORIZATION.
# PAGE_BUILDER_CMS_CONTAINER_CONFIGURATION_ID=0
# Reuses PAGE_BUILDER_CMS_MAPPING_ID, PAGE_BUILDER_CMS_TYPE_OF_MAPPING, PAGE_BUILDER_CMS_WIDGETS_ID.
# PAGE_BUILDER_SKIP_SAVE_CMS_CONTAINER_DETAILS=true
#
# Home Page Promo:
# PAGE_BUILDER_HOME_PAGE_PROMO_MASTER_KEY=1788
# PAGE_BUILDER_HOME_PAGE_PROMO_DISPLAY_NAME=Home Page Promo
# PAGE_BUILDER_HOME_PAGE_PROMO_WIDGET_NAME=Home Page Promo
# PAGE_BUILDER_HOME_PAGE_PROMO_WIDGET_CODE=HomePagePromo
# PAGE_BUILDER_HOME_PAGE_PROMO_CONTAINER_KEY=HomePagePromo
# PAGE_BUILDER_HOME_PAGE_PROMO_FILE_NAME=
#
# AdSpace:
# PAGE_BUILDER_AD_SPACE_MASTER_KEY=1787
# PAGE_BUILDER_AD_SPACE_DISPLAY_NAME=AdSpace
# PAGE_BUILDER_AD_SPACE_WIDGET_NAME=AdSpace
# PAGE_BUILDER_AD_SPACE_WIDGET_CODE=AdSpace
# PAGE_BUILDER_AD_SPACE_CONTAINER_KEY=AdSpace
# PAGE_BUILDER_AD_SPACE_FILE_NAME=

# ---------------------------------------------------------------------------
# Link panel — chat: "add link panel" / "add links" / "add link" / "add a link"
# ---------------------------------------------------------------------------
# POST CreateUpdateLinkWidgetConfiguration (server-side; same auth as slider/publish).
# PAGE_BUILDER_CREATE_UPDATE_LINK_WIDGET_URL=https://apigateways-z10-dev10.znodecorp.com/CMSWidgetConfiguration/CreateUpdateLinkWidgetConfiguration
# Reuses PAGE_BUILDER_SLIDER_AUTHORIZATION or PAGE_BUILDER_PUBLISH_PREVIEW_AUTHORIZATION.
# Reuses PAGE_BUILDER_CMS_MAPPING_ID, PAGE_BUILDER_CMS_TYPE_OF_MAPPING, PAGE_BUILDER_CMS_WIDGETS_ID.
# Composite WidgetsKey per save: PAGE_BUILDER_LINK_PANEL_MASTER_KEY (default 2253) + UUID (matches page widgetKey).
# PAGE_BUILDER_LINK_PANEL_MASTER_KEY=2253
# Form "display name" → API **Title**; **DisplayName** / **WidgetName** default **Link Panel** (widget panel label):
# PAGE_BUILDER_LINK_PANEL_DISPLAY_NAME=Link Panel
# PAGE_BUILDER_LINK_WIDGET_LOCALE_ID=1
# PAGE_BUILDER_PORTAL_ID=0
# Optional — defaults match current gateway sample (false / false / 999 / false):
# PAGE_BUILDER_LINK_WIDGET_IS_ACTIVE=true
# PAGE_BUILDER_LINK_WIDGET_IS_NEW_TAB=true
# PAGE_BUILDER_LINK_WIDGET_DISPLAY_ORDER=0
# PAGE_BUILDER_LINK_WIDGET_ENABLE_CMS_PREVIEW=true
# Local/dev without calling gateway: PAGE_BUILDER_SKIP_CREATE_UPDATE_LINK_WIDGET=true

# ---------------------------------------------------------------------------
# Products carousel — chat intents
# ---------------------------------------------------------------------------
# **add product carousel** / **add products** → new WidgetsKey every time (`PAGE_BUILDER_PRODUCT_CAROUSEL_MASTER_KEY` + UUID). List may be empty until CMS has unassociated rows for that key.
# **update** / **change** / **edit** / **refresh** + **product(s) carousel** → reuse `widgetKey` from the last ProductsCarousel on the page; if none, uses **PAGE_BUILDER_PRODUCT_CAROUSEL_WIDGET_KEY** or dev default (666-cd3d61f0-...).
# PAGE_BUILDER_PRODUCT_CAROUSEL_WIDGET_KEY=666-cd3d61f0-462b-447c-b6f0-58d1fb273401
# Optional (rare): PAGE_BUILDER_PRODUCT_CAROUSEL_RANDOM_WIDGET_KEY=true affects only the env fallback key path.
#
# GetUnAssociatedProductList: GET with query string plus Content-Type: application/x-www-form-urlencoded body (expand, filter, sort, pageIndex, pageSize).
# Debug curl (Authorization redacted) when NODE_ENV is not production, or PAGE_BUILDER_LOG_PRODUCT_LIST_CURL=true / false
#
# GET unassociated products (OData-style filter built server-side):
# PAGE_BUILDER_GET_UNASSOCIATED_PRODUCT_LIST_URL=https://apigateways-z10-dev10.znodecorp.com/CMSWidgetConfiguration/GetUnAssociatedProductList
# POST associate selected SKUs:
# PAGE_BUILDER_ASSOCIATE_PRODUCT_URL=https://apigateways-z10-dev10.znodecorp.com/CMSWidgetConfiguration/AssociateProduct
# Reuses PAGE_BUILDER_SLIDER_AUTHORIZATION or PAGE_BUILDER_PUBLISH_PREVIEW_AUTHORIZATION.
# PAGE_BUILDER_PRODUCT_CAROUSEL_MASTER_KEY=666
# PAGE_BUILDER_PRODUCT_CAROUSEL_DISPLAY_NAME=Product List
# PAGE_BUILDER_PRODUCT_CAROUSEL_WIDGET_CODE=ProductList
# PAGE_BUILDER_PRODUCT_LIST_PAGE_SIZE=10
# PAGE_BUILDER_PRODUCT_LIST_LOCALE_ID=1
# PAGE_BUILDER_ASSOCIATE_PRODUCT_CMS_WIDGETS_ID=1
# PAGE_BUILDER_ASSOCIATE_PRODUCT_ENABLE_PREVIEW=false
# Reuses PAGE_BUILDER_CMS_MAPPING_ID, PAGE_BUILDER_CMS_TYPE_OF_MAPPING.
# "Add carousel" POSTs AssociateProduct with selected SKUs and the same widgetsKey as the list (omit or false to enable).
# PAGE_BUILDER_SKIP_ASSOCIATE_PRODUCT=false

# ---------------------------------------------------------------------------
# Publish to preview — server-side proxy (Authorization not exposed to browser)
# ---------------------------------------------------------------------------
# PAGE_BUILDER_PUBLISH_PREVIEW_URL=https://apigateways-z10-dev10.znodecorp.com/v2/visual-editor/pages-publish-preview
# PAGE_BUILDER_PUBLISH_PREVIEW_AUTHORIZATION=Basic <paste-value-from-gateway>
# If Node fails TLS to the gateway (unable to verify certificate), prefer:
#   NODE_EXTRA_CA_CERTS=C:\path\to\corp-root-ca.pem
# In next dev, TLS verification for this upstream is skipped by default (corporate dev gateways).
# To enforce TLS in dev: PAGE_BUILDER_PUBLISH_PREVIEW_TLS_INSECURE=false
# In production, verification is on unless: PAGE_BUILDER_PUBLISH_PREVIEW_TLS_INSECURE=true

# NEXT_DEV_POLL=1   # if dev watcher hangs on Windows
